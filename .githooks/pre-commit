#!/bin/sh
# Refuses a commit that would add game data (tools/check_no_game_data.py), before it can
# reach a pull request. Enable once per clone:
#   git config core.hooksPath .githooks
PY=
for p in python3 python; do
  if "$p" -c "import sys" >/dev/null 2>&1; then PY=$p; break; fi
done
if [ -z "$PY" ]; then
  echo "pre-commit: Python not found, so the game-data check can't run. Install Python 3." >&2
  exit 1
fi
git diff --cached --name-only -z --diff-filter=ACMR | xargs -0 -r "$PY" tools/check_no_game_data.py
